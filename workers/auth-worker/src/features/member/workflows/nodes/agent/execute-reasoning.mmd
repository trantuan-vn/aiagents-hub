flowchart TD
  start([executeReasoningAgent]) --> prep

  subgraph prepare ["1. Prepare"]
    prep["resolveAgentResources<br/>readReasoningOptions (maxReflectRetries = repair rounds)<br/>resolveAgentUserText + PDF text"]
    prep --> screenIn{"ruleClassify input"}
    screenIn -->|refuse| refusedIn([status refused, no LLM])
    screenIn -->|ok / review| epGate{"injected llm or endpoint?"}
    epGate -->|neither| missingEp([throw missing serviceEndpoint])
    epGate -->|yes| model["ensureWalletBalance<br/>resolveServiceByEndpoint<br/>createDefaultLlm (bills per call)"]
    model --> reviewGate{"input flagged review?"}
    reviewGate -->|yes| safetyLlm["LLM purpose safety"]
    safetyLlm -->|refuse| refusedReview([status refused])
    safetyLlm -->|allow| memory
    reviewGate -->|no| memory["loadSessionMemory<br/>attachSimpleMemory<br/>interpolate systemPrompt (ragText blanked)"]
    memory --> emptyGate{"empty question and ask mode?"}
    emptyGate -->|yes| emptyAsk([needs_clarification])
    emptyGate -->|no| branch{"linked Check SQL tool?"}
  end

  branch -->|yes| rewrite
  branch -->|no| chatPrefetch

  subgraph sqlPipeline ["2a. Text-to-SQL: generate → execute → repair"]
    rewrite{"system prompt has domain vocabulary?"}
    rewrite -->|yes| rewriteLlm["LLM purpose rewrite<br/>(retrieval query only)"]
    rewrite -->|no| retrieve
    rewriteLlm --> retrieve["prefetchLinkedGetRag<br/>(host does schema linking)"]
    retrieve --> gen["LLM purpose sql<br/>system = user prompt + SQL rules<br/>user = question + retrieved schema<br/>(+ previous SQL + Oracle error on repair)"]
    gen --> parse{"parseSqlReply"}
    parse -->|"ASK: … (ask mode)"| askOut([needs_clarification])
    parse -->|no SQL| more
    parse -->|SQL| check["executeCheckSql (EXPLAIN PLAN)"]
    check -->|ok| okSql([status ok<br/>validated true, columns, rowCount, attempts])
    check -->|missing credentials| cfgErr([throw config error])
    check -->|Oracle error| refreshGate{"ORA-00904 / 00942 and repairs left?"}
    refreshGate -->|yes| refresh["get_rag(oracleRetrieveQuery(error))<br/>mergeSchemaContext"]
    refresh --> more
    refreshGate -->|no| more{"repairs left?"}
    more -->|yes| gen
    more -->|no| exhausted{"ask mode or no draft?"}
    exhausted -->|yes| askLlm["LLM purpose ask<br/>one question in user language"]
    askLlm --> exhaustedAsk([needs_clarification])
    exhausted -->|no| bestEffort([status ok<br/>validated false, reason = last error])
  end

  subgraph toolChat ["2b. Generic tool chat"]
    chatPrefetch["prefetchLinkedGetRag<br/>retrieveSemanticMemory when no get-rag"]
    chatPrefetch --> toolset["HTTP + linked tools (no Code Mode)<br/>+ retrieve_memory + ask_user (ask mode)<br/>filterToolsForSafety"]
    toolset --> act["LLM purpose act<br/>generateText with tools, stopWhen stepCountIs(maxActSteps)"]
    act --> askedGate{"ask_user called?"}
    askedGate -->|yes| chatAsk([needs_clarification])
    askedGate -->|no| cite["buildCitations<br/>groundedTextOrFallback when citations required"]
    cite --> okChat([status ok])
  end

  okSql --> emit
  bestEffort --> emit
  askOut --> emit
  exhaustedAsk --> emit
  chatAsk --> emit
  okChat --> emit
  emptyAsk --> emit

  subgraph finish ["3. Emit"]
    emit["ruleClassify output (ok only)<br/>saveSessionMemory + simpleMemory.persist (not for refused)<br/>toNodeOutput (+ trace when traceCodeMode)"]
  end
